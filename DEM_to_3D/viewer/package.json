{
  "name": "terrain-3d-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare:dataset": "python scripts/validate_dataset.py --prepare",
    "predev": "npm run prepare:dataset",
    "dev": "vite",
    "prebuild": "npm run prepare:dataset",
    "build": "npm run build:app",
    "build:app": "tsc -b && vite build",
    "validate:dataset": "python scripts/validate_dataset.py",
    "test:dataset": "python -m unittest discover -s scripts -p test_validate_dataset.py",
    "test:api": "python -m unittest discover -s scripts -p test_serve_workspace.py",
    "serve:workspace": "python scripts/serve_workspace.py",
    "pretypecheck": "npm run prepare:dataset",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prepare:dataset",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/area": "^7.3.4",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/intersect": "^7.3.4",
    "@turf/union": "^7.3.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "proj4": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
